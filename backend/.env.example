# Sao chép thành .env rồi điền giá trị thật:  copy .env.example .env

# ===== MySQL =====
# XAMPP mặc định: user root, mật khẩu để trống
DB_HOST=localhost
DB_PORT=3306
DB_NAME=eduguard
DB_USER=root
DB_PASSWORD=

# ===== Bảo mật =====
# Chuỗi ngẫu nhiên dài để ký token đăng nhập. BẮT BUỘC đổi khi dùng thật.
SECRET_KEY=doi-chuoi-nay-thanh-mot-chuoi-ngau-nhien-dai
# true khi chạy sau HTTPS
COOKIE_SECURE=false

LOG_LEVEL=INFO
