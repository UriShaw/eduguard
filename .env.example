# Sao chép thành .env rồi điền giá trị thật:  copy .env.example .env

# ===== MySQL =====
DB_HOST=localhost
DB_PORT=3306
DB_NAME=eduguard
DB_USER=root
DB_PASSWORD=
# Đặt DATABASE_URL để ghi đè toàn bộ 5 biến trên (vd dùng SQLite khi thử nhanh)
# DATABASE_URL=mysql+pymysql://user:pass@host:3306/eduguard?charset=utf8mb4

# ===== Flask =====
FLASK_ENV=development
SECRET_KEY=doi-chuoi-nay-thanh-mot-chuoi-ngau-nhien-dai

# ===== Log =====
LOG_LEVEL=INFO
# text = dễ đọc khi dev | json = dễ thu thập khi chạy thật
LOG_FORMAT=text
# LOG_DIR=logs

# ===== Máy chủ phát triển =====
# Đổi nếu cổng 5000 đã bị ứng dụng khác chiếm
PORT=5000
