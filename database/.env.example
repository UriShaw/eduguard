# Cấu hình kết nối MySQL cho backend.
# Sao chép thành .env trong CHÍNH thư mục này rồi điền giá trị thật:  copy .env.example .env

# XAMPP mặc định: user root, mật khẩu để trống
DB_HOST=localhost
DB_PORT=3306
DB_NAME=eduguard
DB_USER=root
DB_PASSWORD=

# Hoặc dùng một chuỗi kết nối duy nhất — có thì bỏ qua mọi biến DB_* ở trên:
# DATABASE_URL=mysql+pymysql://root:matkhau@localhost:3306/eduguard?charset=utf8mb4
